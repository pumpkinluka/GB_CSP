    # update uppercase variable to true


characters = False
uppercase = False
lowercase = False
number = False
symbol = False
rules = 0
strength = 'invalid"

password = input("What is your password:").strip()

if (len(password)) >= 8:
    characters = True
    rules = 1
elif password .isupper():
    uppercase = True
    rules = 2
elif password .islower():
    lowercase = True
    rules = 3
elif password .isnumeric():
    number = True
    rules = 4
elif password in "!@#$%^&*()_-=+[]{|\/.,<>?:;}"
    symbol = True
    rules = 5

if rules == 5
    strength = "Strong"
elif rules <= 4 and rules > 2
    strength = "Medium"
elif rules <= 2
    strength = "Weak"


print(f"At least 8 characters: {characters}")
print(f"Has an uppercase letter: {uppercase} ")
print(f"Has a lowercase letter: {lowercase}")
print(f"Has a number: {number}")
print(f"Has a symbol: {symbol}")
print(f"Your password strength is: {strength}")
